# 复制为 .env 后按需修改；不提交 .env
# 数据库强口令（compose 从这里注入，勿写回 compose 文件）
POSTGRES_PASSWORD=换成至少16位随机串
DATABASE_URL=postgresql+psycopg://catalog:本地开发口令@localhost:5432/catalog
# 自动化建表（开发用 1，生产用 Alembic 迁移时设 0）
AUTO_CREATE_SCHEMA=1
LOG_LEVEL=INFO
LOG_JSON=1
CORS_ORIGINS=

# 认证模式：off | apikey | oidc | both（生产建议 oidc 或 both）
AUTH_MODE=apikey
AUTH_ENABLED=0
# OIDC（AUTH_MODE 含 oidc 时必填）
OIDC_ISSUER=
OIDC_AUDIENCE=data-catalog-api
OIDC_JWKS_URI=
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_ROLE_MAP=data-catalog-admin:admin,data-catalog-editor:editor,data-catalog-viewer:viewer
API_KEYS=
AUDIT_LOG_PATH=./audit.jsonl
# 生产置 0：关闭 /docs 与 /openapi.json，接口结构不对外暴露
DOCS_ENABLED=1
# JWT 验签结果缓存秒数（不超过 token 自身 exp）
OIDC_TOKEN_CACHE_SECONDS=60
